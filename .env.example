# Shared backend settings. Copy this file to .env at the repository root.
# Service-local .env files take precedence when present.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/excalidraw
WEB_ORIGIN=http://localhost:3000
PRESENCE_TICKET_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# HTTP server settings
PORT=5000
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# WebSocket server settings
WS_PORT=8080

# Optional Google OAuth and email delivery
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Excalidraw <onboarding@resend.dev>
