# Shared backend settings. Copy this file to .env at the repository root.
# Service-local .env files take precedence when present.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/excalidraw
REDIS_URL=redis://127.0.0.1:6379
# Optional Redis command-heavy telemetry; keep disabled on command-limited plans.
REDIS_METRICS_ENABLED=false
WEB_ORIGIN=http://localhost:3000
PRESENCE_TICKET_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# HTTP server settings
PORT=5000
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# WebSocket server settings
WS_PORT=8080

# Optional Google OAuth and email delivery
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Excalidraw <onboarding@resend.dev>

# Optional S3 / Cloudflare R2 Presigned Object Storage (Phase 1.3)
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Optional Flush Worker Concurrency (Phase 1.2, default: 8)
# FLUSH_WORKER_CONCURRENCY=8

# Optional Server-Default AI Provider Keys (Phase 4.3 — users can also bring their own keys in-browser)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
