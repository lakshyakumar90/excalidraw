{
  "name": "@repo/auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./presence-ticket": {
      "types": "./src/presenceTicket.ts",
      "default": "./dist/presenceTicket.js"
    },
    "./room-invitation": {
      "types": "./src/roomInvitation.ts",
      "default": "./dist/roomInvitation.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "bcrypt": "^6.0.0",
    "better-auth": "1.7.7",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "26.4.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  }
}
