{
  "name": "@repo/common",
  "version": "0.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    }
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  }
}
