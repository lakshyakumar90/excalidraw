// use prisma-next

model User {
  id         String       @id @default(cuid(2))
  email      String       @unique
  password   String       
  username   String?
  name       String?
  avatar     String?
  rooms      Room[]       @relation("RoomAdmin")
  chats      Chat[]
  membership RoomMember[]
  scenes     Scene[]
  createdAt  TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Room {
  id        Int          @id @default(autoincrement())
  slug      String       @unique
  adminId   String
  admin     User         @relation("RoomAdmin", fields: [adminId], references: [id])
  chats     Chat[]
  members   RoomMember[]
  sceneId   String?      @unique
  scene     Scene?       @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  invites   Invite[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model RoomMember {
  id       Int    @id @default(autoincrement())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId   Int
  room     Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  role     RoomRole @default(editor)
  joinedAt TimestamptzString @default(now())

  @@unique([userId, roomId])
}

enum RoomRole {
  owner
  editor
  viewer
}

model Scene {
  id        String   @id @default(cuid(2))
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String   @default("Untitled")
  data      Jsonb
  room      Room?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([ownerId, updatedAt])
}

model Invite {
  id        String   @id @default(cuid(2))
  codeHash  String   @unique
  email     String
  roomId    Int
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  expiresAt TimestamptzString
  usedAt    TimestamptzString?
  createdAt TimestamptzString @default(now())

  @@index([roomId, email])
}

model Chat {
  id        Int    @id @default(autoincrement())
  roomId    Int
  room      Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  message   String
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  createdAt TimestamptzString @default(now())

  @@index([roomId])
  @@index([userId])
}
