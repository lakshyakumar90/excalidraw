# Copy to .env.ec2 ON EC2. Never commit the populated file.
# Run Compose with --env-file .env.ec2 -f compose.ec2.yaml.
BACKEND_IMAGE=excalidraw-backend:ec2
API_DOMAIN=api.example.com
WS_DOMAIN=ws.example.com
ACME_EMAIL=you@example.com

# Frontend's exact production origin; no trailing slash or comma-separated list.
WEB_ORIGIN=https://app.example.com
BETTER_AUTH_URL=https://api.example.com
PORT=5000
WS_PORT=8080

# Keep your existing Neon URL, including its TLS/query parameters.
# Single quotes protect literal dollar signs from Compose interpolation.
DATABASE_URL='postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require'
# Reuse the existing production secrets to preserve sessions/invite signatures.
# For a new installation, generate a DIFFERENT random 32-byte hex value for each.
BETTER_AUTH_SECRET='REPLACE_WITH_EXISTING_SECRET_OR_RANDOM_64_HEX_CHARACTERS'
PRESENCE_TICKET_SECRET='REPLACE_WITH_EXISTING_SECRET_OR_DIFFERENT_RANDOM_64_HEX_CHARACTERS'
# Optional: copy this too if the previous deployment used a separate invite key.
# ROOM_INVITE_SECRET='REPLACE_WITH_EXISTING_INVITE_SECRET'

# Required for account verification/reset emails in this application.
RESEND_API_KEY='re_REPLACE_ME'
EMAIL_FROM='Excalidraw <accounts@example.com>'

# Optional Google login. Leave both blank if disabled in Vercel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Per-process V8 heap target for the small host (not a total RAM limit).
# Increase after measuring memory or upgrading the instance.
APP_NODE_OPTIONS=--max-old-space-size=128
# Compose sets NODE_ENV=production, REDIS_URL=redis://redis:6379,
# and REDIS_METRICS_ENABLED=false on all three backend services.
