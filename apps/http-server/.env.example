# Use the same PostgreSQL database for the HTTP server and @repo/db.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/excalidraw

PORT=5000
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
WEB_ORIGIN=http://localhost:3000

# Short-lived presence tickets for Phase 14 WebSocket handshakes.
# Must match the ws-server value. Never commit the real secret.
PRESENCE_TICKET_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Google OAuth is enabled when both values are set.
# Register http://localhost:5000/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email verification uses Resend in production. In development, the link is logged by the HTTP server.
RESEND_API_KEY=
EMAIL_FROM=Excalidraw <onboarding@resend.dev>
