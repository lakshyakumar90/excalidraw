NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Presence WebSocket server (Phase 14: cursors and viewport only, no scene sync).
NEXT_PUBLIC_WS_URL=ws://localhost:8080
# Optional same-origin deployment proxy (leave both unset for direct API access).
# API_PROXY_TARGET=https://your-backend-host
# NEXT_PUBLIC_API_PROXY_PREFIX=/backend
# With this proxy, NEXT_PUBLIC_API_URL must be the frontend's HTTPS origin.
# LEGACY_WEB_HOST=your-previous-app.vercel.app
# Optional: redirects that old hostname to NEXT_PUBLIC_API_URL in proxy mode.
