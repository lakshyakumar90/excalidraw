# Use the same PostgreSQL database and ticket secret as the HTTP server.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/excalidraw
PRESENCE_TICKET_SECRET=replace-with-a-random-secret-at-least-32-characters-long

WS_PORT=8080
WEB_ORIGIN=http://localhost:3000
# Optional extra origins allowed to open a WebSocket, comma-separated.
WS_ALLOWED_ORIGINS=
